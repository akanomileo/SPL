# Public metadata URL (optional locally); use your actual HTTPS domain for hosting.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_BASE_PATH=

# Production: set NODE_ENV=production and PUBLIC_ORIGIN to the HTTPS domain root.
# PUBLIC_ORIGIN=https://your-actual-domain.com
# HOST=0.0.0.0
# PORT=4174
# DATA_DIRECTORY=/persistent/private/spl-data
# Store private data outside the public web root. Do not commit it.

# Google sign-in (required for checkout and owner access). Configure all three fields together; keep the secret private.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Choose the single owner using npm run owner:setup; no owner email allowlist.

# Vercel storefront proxy deployment only: set the same long random secret in
# Vercel and the persistent Node backend. Set BACKEND_ORIGIN in Vercel to the
# backend's HTTPS origin. These values are not needed for a standalone install.
BACKEND_ORIGIN=
VERCEL_PROXY_SECRET=

# New unpaid orders expire after this many minutes only if no receipt was ever uploaded.
# Existing orders keep their current state and have no invented deadline.
RESERVATION_MINUTES=1440
MAX_UNPAID_ORDERS=3

# Exact IPs of reverse proxies you control. Leave empty for direct connections.
# The proxy must overwrite or append X-Forwarded-For and prevent direct public
# access to the application port. Example for a same-host proxy: 127.0.0.1,::1
TRUSTED_PROXY_IPS=

# Cumulative receipt limits include removed photos retained for audit history.
# MB here means 1024 * 1024 bytes. These limits do not delete existing evidence.
MAX_ORDER_RECEIPT_FILES=60
MAX_ORDER_RECEIPT_MB=120
MAX_CUSTOMER_RECEIPT_MB=512
MAX_RECEIPT_STORAGE_MB=5120
RECEIPT_UPLOADS_PER_HOUR=40
